# ============================================
# IIPAS Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# MongoDB Connection
MONGODB_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/iipas?retryWrites=true&w=majority

# JWT Secret (any random string, use: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-here

# Google Gemini AI API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Super Admin Credentials
ADMIN_EMAIL=admin@iipas.com
ADMIN_PASSWORD=your-admin-password-here
